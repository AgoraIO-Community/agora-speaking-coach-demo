# Public Agora App ID: required at build and runtime.
NEXT_PUBLIC_AGORA_APP_ID=

# Server runtime only. Never expose this certificate to the browser or build arguments.
NEXT_AGORA_APP_CERTIFICATE=

# --- Saved practice history (all optional) ---------------------------------
# Where progress is stored: file (default), sqlite or postgres.
#   file     one JSON file; zero setup; local development and a single Docker container
#   sqlite   a SQLite database file (Node's built-in node:sqlite); same hosts as file
#   postgres a hosted database such as Neon or Supabase; required on serverless hosts
#            (for example Vercel), where local files do not persist
# An unknown value or a missing DATABASE_URL is an error; there is no silent fallback.
# PROGRESS_STORE=file

# Directory for the file and sqlite stores. Mount a volume here in Docker.
# PROGRESS_DATA_DIR=.scenario-data

# Connection string for PROGRESS_STORE=postgres (Neon or Supabase). Server only.
# DATABASE_URL=

# This app's PUBLIC base URL: a hosted deployment or a tunnel such as
# https://<id>.ngrok.app. Agora's cloud calls it, so localhost does not work.
# Unset (default): the browser reports each finished session, the learner marks
# lessons complete, the coach has no tools and conversations are not logged.
# Set: the coach records corrections and the lesson result itself through
#   <url>/api/progress/coach, and <url>/api/agora-webhook can receive Agora's
#   webhook (see AGORA_WEBHOOK_SECRET).
# COACH_PUBLIC_BASE_URL=

# Conversation logging. Signing secret of the Agora project's webhook
# configuration. With this AND COACH_PUBLIC_BASE_URL set, the text of each
# finished conversation is stored in the progress store (never audio). Server
# only. Enabling it also requires pointing the project's "agent history"
# webhook at <COACH_PUBLIC_BASE_URL>/api/agora-webhook; see AGENTS.md.
# AGORA_WEBHOOK_SECRET=

# --- Speech recognition (optional, server only) -----------------------------
# Default (all unset): Agora ARES, managed by Agora with no vendor key, listening
# for English plus the selected practice language (for example en-US,es-ES),
# with the selected lesson's phrases sent as recognition keywords.
#
# Measured with synthetic voices only (macOS text-to-speech played into a
# muted headless browser as a fake microphone; three Spanish voice conditions).
# For "Hola." / "Me llamo <name>." / "Vivo en Boston.", exact text came back in:
#   ARES en-US,es-ES (with or without keywords)  102 of 102, English 68 of 68
#   Deepgram nova-3 multi (the earlier default)    47 of 210, English 138 of 140
#   Deepgram multi + language_hint as one string    8 of 30 (no better)
#   Deepgram multi + endpointing 100                7 of 30 (no better)
#   Deepgram multi + language_hint as a list        0 of 30: every turn EMPTY
#   Deepgram language es                           20 of 30, English 4 of 20
# "Me llamo <name>." alone: ARES 34 of 34, Deepgram multi 0 of 70.
# Deepgram `keyterm` on multi changed nothing in any accepted form, and a
# keyterm string containing spaces also returned empty text for every turn.
# A real accented learner was not measured; confirm with your own voice.
# Details: ARCHITECTURE.md, "Speech configuration".
#
# COACH_STT_VENDOR=deepgram returns to Deepgram nova-3 `multi`.
# COACH_STT_KEYWORDS=off stops sending lesson keywords to ARES. Keywords fixed
#   the practice name in French and Korean tests (4 of 4 against 0 of 4), and
#   deliberately wrong phrases were still transcribed as spoken. They nudge the
#   recognizer toward the lesson phrases, so a transcript can show the expected
#   phrase when the learner was only close to it.
# COACH_STT_VENDOR=deepgram
# COACH_STT_KEYWORDS=off
#
# Deepgram fallback tuning; ignored unless COACH_STT_VENDOR=deepgram.
# COACH_STT_LANGUAGE_HINT adds Deepgram's `language_hint`:
#   on      English plus the practice language, sent as a list. DO NOT USE: in
#           every test it returned empty recognized text for every learner
#           turn, with no error. This, not endpointing, caused the earlier
#           empty transcripts.
#   single  only the practice language, sent as one string; no measured gain
#   off     no hint (default)
# COACH_STT_ENDPOINTING sends Deepgram `endpointing` in milliseconds (10-5000);
# 100 measured no better than the default.
# COACH_STT_LANGUAGE_HINT=single
# COACH_STT_ENDPOINTING=100
