# Public Agora App ID: required at build and runtime.
NEXT_PUBLIC_AGORA_APP_ID=

# Server runtime only. Never expose this certificate to the browser or build arguments.
NEXT_AGORA_APP_CERTIFICATE=

# --- Saved practice history (all optional) ---------------------------------
# Where progress is stored: file (default), sqlite or postgres.
#   file     one JSON file; zero setup; local development and a single Docker container
#   sqlite   a SQLite database file (Node's built-in node:sqlite); same hosts as file
#   postgres a hosted database such as Neon or Supabase; required on serverless hosts
#            (for example Vercel), where local files do not persist
# An unknown value or a missing DATABASE_URL is an error; there is no silent fallback.
# PROGRESS_STORE=file

# Directory for the file and sqlite stores. Mount a volume here in Docker.
# PROGRESS_DATA_DIR=.scenario-data

# Connection string for PROGRESS_STORE=postgres (Neon or Supabase). Server only.
# DATABASE_URL=

# This app's PUBLIC base URL: a hosted deployment or a tunnel such as
# https://<id>.ngrok.app. Agora's cloud calls it, so localhost does not work.
# Unset (default): the browser reports each finished session, the learner marks
# lessons complete, the coach has no tools and conversations are not logged.
# Set: the coach records corrections and the lesson result itself through
#   <url>/api/progress/coach, and <url>/api/agora-webhook can receive Agora's
#   webhook (see AGORA_WEBHOOK_SECRET).
# COACH_PUBLIC_BASE_URL=

# Conversation logging. Signing secret of the Agora project's webhook
# configuration. With this AND COACH_PUBLIC_BASE_URL set, the text of each
# finished conversation is stored in the progress store (never audio). Server
# only. Enabling it also requires pointing the project's "agent history"
# webhook at <COACH_PUBLIC_BASE_URL>/api/agora-webhook; see AGENTS.md.
# AGORA_WEBHOOK_SECRET=
